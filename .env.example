# The labeled demo is the default when APP_MODE is unset. Set cloud to require Firebase.
APP_MODE=demo
QR_SIGNING_SECRET=replace-with-at-least-32-random-bytes

# Optional Firebase Spark/Blaze configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=

# Optional Vertex AI. Cloud Run uses its service identity; never commit credentials.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
