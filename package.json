{
  "name": "orvio-pulse",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rules": "vitest run --config vitest.rules.config.mts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@google/genai": "2.19.0",
    "firebase": "12.18.0",
    "firebase-admin": "14.3.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "firebase-tools": "15.28.2",
    "happy-dom": "^20.11.15",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "uuid": "11.1.1",
    "@opentelemetry/core": "2.8.0"
  }
}
